# Copia este archivo a .env.local y rellena los valores.
# .env.local no se sube a Git (está en .gitignore).

# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (obligatorio para imágenes existentes / transformaciones)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Marca de agua en galería de eventos: public_id del logo subido a Cloudinary (ej. watermark). Ver public/watermark.png
NEXT_PUBLIC_CLOUDINARY_WATERMARK_PUBLIC_ID=

# Cloudflare R2 (obligatorio para subir nuevas fotos; las nuevas se guardan aquí)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
# URL pública del bucket (ej. https://pub-xxx.r2.dev o dominio custom)
CLOUDFLARE_R2_PUBLIC_URL=
# Misma URL pero expuesta al cliente (portafolio, servicios) para mostrar imágenes
NEXT_PUBLIC_R2_PUBLIC_URL=

# URL pública del sitio (para Webpay return_url y emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Contacto (opcional, se usan en /contacto)
NEXT_PUBLIC_CONTACT_EMAIL=info@fotosmony.cl
NEXT_PUBLIC_CONTACT_PHONE=+56 9 XXXX XXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=569XXXXXXXX

# Webpay (solo si usas checkout con pago)
WEBPAY_API_KEY_ID=
WEBPAY_API_KEY_SECRET=
WEBPAY_BASE_URL=

# Resend (solo si envías emails tras el pago)
RESEND_API_KEY=
RESEND_FROM=
